# ==============================================================================
# HACKFLOW AI - BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct)
# Example: postgres://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:your_password@your_host:5432/postgres

# JWT Security Secrets
JWT_SECRET=hackflow_jwt_secure_key_2026_super_secret_token_signature

# SMTP Email Configuration (Nodemailer MFA & Notifications)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="HackFlow AI" <no-reply@hackflow.dev>
