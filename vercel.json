{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd hackathon-platform/frontend && npm install && npm run build",
  "outputDirectory": "hackathon-platform/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
